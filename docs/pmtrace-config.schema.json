{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhearom.github.io/HollowKnight.DebugMod/docs/pmtrace-config.schema.json",
  "title": "DebugMod PM Trace Config v2",
  "description": "Schema for DebugMod PM Trace profile-based configuration (pmtrace_config.json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxRows",
    "activeProfile",
    "profiles",
    "output",
    "commandScript"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "PM Trace config schema version."
    },
    "maxRows": {
      "type": "integer",
      "minimum": 1,
      "default": 50000,
      "description": "Global in-memory row budget before additional rows are dropped."
    },
    "activeProfile": {
      "type": "string",
      "default": "default_fsm",
      "description": "Profile name used when PM Trace initializes/reloads."
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "description": "Profile map keyed by profile name."
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "commandScript": {
      "$ref": "#/$defs/commandScript"
    }
  },
  "$defs": {
    "patternFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "value",
        "ignoreCase"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "exact",
            "contains",
            "regex"
          ],
          "default": "off"
        },
        "value": {
          "type": "string",
          "default": ""
        },
        "ignoreCase": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneAllowlist",
        "gameObjectFilter",
        "fsmFilter",
        "eventFilter",
        "probeFilter",
        "componentTypeFilter"
      ],
      "properties": {
        "sceneAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "gameObjectFilter": {
          "$ref": "#/$defs/patternFilter"
        },
        "fsmFilter": {
          "$ref": "#/$defs/patternFilter"
        },
        "eventFilter": {
          "$ref": "#/$defs/patternFilter"
        },
        "probeFilter": {
          "$ref": "#/$defs/patternFilter"
        },
        "componentTypeFilter": {
          "$ref": "#/$defs/patternFilter"
        }
      }
    },
    "fsmTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includeHeroSnapshot",
        "includeFsmVars",
        "fsmBoolAllowlist",
        "fsmIntAllowlist",
        "fsmFloatAllowlist"
      ],
      "properties": {
        "includeHeroSnapshot": {
          "type": "boolean",
          "default": true
        },
        "includeFsmVars": {
          "type": "boolean",
          "default": true
        },
        "fsmBoolAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "fsmIntAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "fsmFloatAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "damagePipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includeHitAttempt",
        "includeGateChecks",
        "includeTakeDamage",
        "includeInvincible",
        "includeNonFatalHit",
        "includeLimitSendEvents"
      ],
      "properties": {
        "includeHitAttempt": {
          "type": "boolean",
          "default": true
        },
        "includeGateChecks": {
          "type": "boolean",
          "default": true
        },
        "includeTakeDamage": {
          "type": "boolean",
          "default": true
        },
        "includeInvincible": {
          "type": "boolean",
          "default": true
        },
        "includeNonFatalHit": {
          "type": "boolean",
          "default": true
        },
        "includeLimitSendEvents": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "colliderContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includeTriggerEnter",
        "includeTriggerStay",
        "includeTriggerExit",
        "includeCollisionEvents",
        "sourceObjectFilter",
        "targetObjectFilter"
      ],
      "properties": {
        "includeTriggerEnter": {
          "type": "boolean",
          "default": true
        },
        "includeTriggerStay": {
          "type": "boolean",
          "default": false
        },
        "includeTriggerExit": {
          "type": "boolean",
          "default": true
        },
        "includeCollisionEvents": {
          "type": "boolean",
          "default": false
        },
        "sourceObjectFilter": {
          "$ref": "#/$defs/patternFilter"
        },
        "targetObjectFilter": {
          "$ref": "#/$defs/patternFilter"
        }
      }
    },
    "componentToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentTypeAllowlist",
        "pollIntervalSeconds",
        "maxComponentsPerSample",
        "includeInactiveGameObjects"
      ],
      "properties": {
        "componentTypeAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "pollIntervalSeconds": {
          "type": "number",
          "minimum": 0,
          "default": 0.25
        },
        "maxComponentsPerSample": {
          "type": "integer",
          "minimum": 1,
          "default": 256
        },
        "includeInactiveGameObjects": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "fieldWatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeName",
        "fieldName"
      ],
      "properties": {
        "typeName": {
          "type": "string"
        },
        "fieldName": {
          "type": "string"
        }
      }
    },
    "fieldWatchProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emitOnDamageEvents",
        "emitOnLimitSendEvents",
        "cadenceSeconds",
        "maxObjectsPerSample",
        "serializeCollectionsAsCount",
        "maxCollectionPreviewItems"
      ],
      "properties": {
        "emitOnDamageEvents": {
          "type": "boolean",
          "default": true
        },
        "emitOnLimitSendEvents": {
          "type": "boolean",
          "default": true
        },
        "cadenceSeconds": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "maxObjectsPerSample": {
          "type": "integer",
          "minimum": 1,
          "default": 32
        },
        "serializeCollectionsAsCount": {
          "type": "boolean",
          "default": true
        },
        "maxCollectionPreviewItems": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabledProbes",
        "filters",
        "fsmTransition",
        "damagePipeline",
        "colliderContact",
        "componentToggle",
        "fieldWatches",
        "fieldWatchProbe"
      ],
      "properties": {
        "enabledProbes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "fsmTransition": {
          "$ref": "#/$defs/fsmTransition"
        },
        "damagePipeline": {
          "$ref": "#/$defs/damagePipeline"
        },
        "colliderContact": {
          "$ref": "#/$defs/colliderContact"
        },
        "componentToggle": {
          "$ref": "#/$defs/componentToggle"
        },
        "fieldWatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldWatch"
          },
          "default": []
        },
        "fieldWatchProbe": {
          "$ref": "#/$defs/fieldWatchProbe"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputDirOverride",
        "filePrefix"
      ],
      "properties": {
        "outputDirOverride": {
          "type": "string",
          "default": ""
        },
        "filePrefix": {
          "type": "string",
          "default": "pmtrace"
        }
      }
    },
    "commandScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoRunOnReload"
      ],
      "properties": {
        "autoRunOnReload": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 2,
      "maxRows": 50000,
      "activeProfile": "default_fsm",
      "profiles": {
        "default_fsm": {
          "enabledProbes": [
            "fsm_transition"
          ],
          "filters": {
            "sceneAllowlist": [],
            "gameObjectFilter": {
              "mode": "off",
              "value": "",
              "ignoreCase": true
            },
            "fsmFilter": {
              "mode": "off",
              "value": "",
              "ignoreCase": true
            },
            "eventFilter": {
              "mode": "off",
              "value": "",
              "ignoreCase": true
            },
            "probeFilter": {
              "mode": "off",
              "value": "",
              "ignoreCase": true
            },
            "componentTypeFilter": {
              "mode": "off",
              "value": "",
              "ignoreCase": true
            }
          },
          "fsmTransition": {
            "includeHeroSnapshot": true,
            "includeFsmVars": true,
            "fsmBoolAllowlist": [],
            "fsmIntAllowlist": [],
            "fsmFloatAllowlist": []
          },
          "damagePipeline": {
            "includeHitAttempt": true,
            "includeGateChecks": true,
            "includeTakeDamage": true,
            "includeInvincible": true,
            "includeNonFatalHit": true,
            "includeLimitSendEvents": true
          },
          "colliderContact": {
            "includeTriggerEnter": true,
            "includeTriggerStay": false,
            "includeTriggerExit": true,
            "includeCollisionEvents": false,
            "sourceObjectFilter": {
              "mode": "off",
              "value": "",
              "ignoreCase": true
            },
            "targetObjectFilter": {
              "mode": "off",
              "value": "",
              "ignoreCase": true
            }
          },
          "componentToggle": {
            "componentTypeAllowlist": [],
            "pollIntervalSeconds": 0.25,
            "maxComponentsPerSample": 256,
            "includeInactiveGameObjects": true
          },
          "fieldWatches": [],
          "fieldWatchProbe": {
            "emitOnDamageEvents": true,
            "emitOnLimitSendEvents": true,
            "cadenceSeconds": 0,
            "maxObjectsPerSample": 32,
            "serializeCollectionsAsCount": true,
            "maxCollectionPreviewItems": 5
          }
        }
      },
      "output": {
        "outputDirOverride": "",
        "filePrefix": "pmtrace"
      },
      "commandScript": {
        "autoRunOnReload": false
      }
    }
  ]
}
