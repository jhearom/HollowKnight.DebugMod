{
  "artifact_version": "2.0.0",
  "feature": "DebugMod PlayMaker Runtime Trace (PM Trace)",
  "schema_version": 2,
  "default_patch_scope": "1.5.78.11833",
  "secondary_patch_scope": "1.5.12459 (best effort)",
  "runtime_target": "Windows 11",
  "development_environment": "Ubuntu 24.04",
  "defaults": {
    "enabled_at_launch": false,
    "enabled_after_reload": false,
    "max_rows": 50000,
    "active_profile": "default_fsm"
  },
  "config": {
    "primary_path": "%APPDATA%\\..\\LocalLow\\Team Cherry\\Hollow Knight\\DebugModData\\pmtrace_config.json",
    "windows_template_path": "%APPDATA%\\..\\LocalLow\\Team Cherry\\Hollow Knight\\DebugModData\\pmtrace_config.template.windows.json",
    "schema_path": "docs/pmtrace-config.schema.json",
    "top_level_keys": [
      "schemaVersion",
      "maxRows",
      "activeProfile",
      "profiles",
      "output",
      "commandScript"
    ],
    "command_script": {
      "path": "%APPDATA%\\..\\LocalLow\\Team Cherry\\Hollow Knight\\DebugModData\\pmtrace_commands.txt",
      "auto_run_key": "commandScript.autoRunOnReload"
    },
    "built_in_profiles": [
      {
        "name": "default_fsm",
        "enabled_probes": [
          "fsm_transition"
        ]
      },
      {
        "name": "combat_minimal",
        "enabled_probes": [
          "fsm_transition",
          "damage_pipeline"
        ]
      },
      {
        "name": "shriek_hitgate",
        "enabled_probes": [
          "fsm_transition",
          "damage_pipeline",
          "collider_contact",
          "field_watch"
        ]
      }
    ]
  },
  "probes": [
    {
      "name": "fsm_transition",
      "hooks": [
        "HutongGames.PlayMaker.Fsm.DoTransition",
        "HutongGames.PlayMaker.Fsm.SetState"
      ],
      "event_examples": [
        "__unknown_event__",
        "__direct_set_state__"
      ],
      "payload": {
        "optional": [
          "hero_state",
          "hero_flags",
          "fsm_vars"
        ]
      }
    },
    {
      "name": "damage_pipeline",
      "hooks": [
        "HealthManager.Hit",
        "HealthManager.TakeDamage",
        "HealthManager.Invincible",
        "HealthManager.NonFatalHit",
        "HealthManager.IsBlockingByDirection",
        "HealthManager.CheckInvincible",
        "LimitSendEvents.Add",
        "LimitSendEvents.OnEnable"
      ],
      "event_examples": [
        "hit_attempt",
        "hit_result",
        "take_damage_entry",
        "take_damage_exit",
        "invincible_entry",
        "invincible_exit",
        "non_fatal_hit",
        "gate_block_check",
        "check_invincible",
        "limit_send_add",
        "limit_send_reset"
      ]
    },
    {
      "name": "collider_contact",
      "hooks": [
        "PlayMakerUnity2DProxy.OnTriggerEnter2D",
        "PlayMakerUnity2DProxy.OnTriggerStay2D",
        "PlayMakerUnity2DProxy.OnTriggerExit2D",
        "PlayMakerUnity2DProxy.OnCollisionEnter2D",
        "PlayMakerUnity2DProxy.OnCollisionStay2D",
        "PlayMakerUnity2DProxy.OnCollisionExit2D"
      ],
      "event_examples": [
        "trigger_enter",
        "trigger_stay",
        "trigger_exit",
        "collision_enter",
        "collision_stay",
        "collision_exit"
      ]
    },
    {
      "name": "component_toggle",
      "mode": "bounded cadence sampling",
      "event_examples": [
        "component_enabled",
        "component_disabled"
      ],
      "notes": [
        "No generic MMHOOK surface exists for UnityEngine.Behaviour.enabled in this runtime.",
        "Sampling is explicit/opt-in via profile componentToggle settings."
      ]
    },
    {
      "name": "field_watch",
      "mode": "event-driven snapshots + optional bounded cadence",
      "watch_keys": [
        "fieldWatches[].typeName",
        "fieldWatches[].fieldName"
      ],
      "event_triggers": [
        "HealthManager.* hooks",
        "LimitSendEvents.* hooks",
        "optional cadence tick"
      ]
    }
  ],
  "global_filters": [
    "sceneAllowlist",
    "gameObjectFilter",
    "fsmFilter",
    "eventFilter",
    "probeFilter",
    "componentTypeFilter"
  ],
  "record_envelope": {
    "required_fields": [
      "session_id",
      "sequence_id",
      "event_type",
      "scene_name",
      "frame_count",
      "fixed_frame_count",
      "time",
      "fixed_time",
      "t_ft",
      "delta_time",
      "fixed_delta_time",
      "unscaled_time",
      "realtime_since_startup"
    ],
    "optional_identity_fields": [
      "source_object",
      "source_fsm",
      "source_instance_id",
      "target_object",
      "target_instance_id",
      "event_name",
      "from_state",
      "to_state",
      "component_type"
    ],
    "payload_field": "payload (probe-specific)"
  },
  "output": {
    "default_directory": "%APPDATA%\\..\\LocalLow\\Team Cherry\\Hollow Knight\\DebugModData\\pmtrace",
    "directory_override_key": "output.outputDirOverride",
    "file_prefix_key": "output.filePrefix",
    "trace_file_pattern": "<filePrefix>_<yyyyMMdd_HHmmss_fff UTC>_<sessionId8>.jsonl",
    "status_file_pattern": "pmtrace_status_<yyyyMMdd_HHmmss_fff UTC>_<sessionId8>.json",
    "flush_triggers": [
      "manual flush",
      "auto flush on disable when unflushed rows exist",
      "auto flush on application quit when unflushed rows exist"
    ],
    "drop_behavior": "When maxRows is reached, additional matching rows are dropped and counted."
  },
  "runtime_controls": {
    "menu": [
      "Enable/Disable Trace",
      "List Profiles",
      "Next Profile",
      "Run Script",
      "Clear Buffer",
      "Flush Trace",
      "Reload Config",
      "Show Status",
      "Dump Status"
    ],
    "command_surface": {
      "interop_method": "DebugExport.ExecutePmTraceCommand(string commandLine)",
      "help_method": "DebugExport.GetPmTraceCommandHelp()",
      "supported_commands": [
        "pmtrace help",
        "pmtrace enable",
        "pmtrace disable",
        "pmtrace clear",
        "pmtrace flush",
        "pmtrace reload",
        "pmtrace status",
        "pmtrace dump_status",
        "pmtrace profiles list",
        "pmtrace profile activate <name>"
      ],
      "response_format": {
        "type": "json-string",
        "fields": [
          "ok",
          "code",
          "message",
          "data (optional)"
        ]
      }
    },
    "script_runner": {
      "entrypoint": "PlayMakerTraceManager.RunCommandScript()",
      "format": "one PM Trace command per line; blank lines and # comments allowed",
      "safety_constraints": [
        "fixed script path inside DebugModData (no path override)",
        "no shell or process execution",
        "64 KiB max file size",
        "128 max executable commands per run",
        "512 max command-line length",
        "forbidden token rejection (;, &&, ||, |, `, $() )",
        "fail-closed on first invalid command/result"
      ]
    }
  },
  "schemas": {
    "config_schema": "docs/pmtrace-config.schema.json",
    "record_schema": "docs/pmtrace-record.schema.json",
    "command_contract": "docs/pmtrace-command-contract.json"
  }
}
