{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhearom.github.io/HollowKnight.DebugMod/docs/pmtrace-record.schema.json",
  "title": "DebugMod PM Trace Record v2",
  "description": "Schema for each JSON object row in PM Trace JSONL output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "sequence_id",
    "event_type",
    "scene_name",
    "frame_count",
    "fixed_frame_count",
    "time",
    "fixed_time",
    "t_ft",
    "delta_time",
    "fixed_delta_time",
    "unscaled_time",
    "realtime_since_startup"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Session identifier for PM Trace runtime instance."
    },
    "sequence_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic per-session row sequence number."
    },
    "event_type": {
      "type": "string",
      "description": "Probe name (e.g., fsm_transition, damage_pipeline)."
    },
    "scene_name": {
      "type": "string"
    },
    "frame_count": {
      "type": "integer"
    },
    "fixed_frame_count": {
      "type": "integer",
      "description": "Proxy from fixedTime / fixedDeltaTime."
    },
    "time": {
      "type": "number"
    },
    "fixed_time": {
      "type": "number"
    },
    "t_ft": {
      "type": "number",
      "description": "time - fixed_time"
    },
    "delta_time": {
      "type": "number"
    },
    "fixed_delta_time": {
      "type": "number"
    },
    "unscaled_time": {
      "type": "number"
    },
    "realtime_since_startup": {
      "type": "number"
    },
    "source_object": {
      "type": "string"
    },
    "source_fsm": {
      "type": "string"
    },
    "source_instance_id": {
      "type": "integer"
    },
    "target_object": {
      "type": "string"
    },
    "target_instance_id": {
      "type": "integer"
    },
    "event_name": {
      "type": "string"
    },
    "from_state": {
      "type": "string"
    },
    "to_state": {
      "type": "string"
    },
    "component_type": {
      "type": "string"
    },
    "payload": {
      "description": "Probe-specific payload object; shape depends on event_type/event_name.",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
